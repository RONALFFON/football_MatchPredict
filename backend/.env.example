# ===== 数据库（复用主站 PostgreSQL，建议改用环境变量/Secret 管理） =====
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASS=

# ===== 通用 AI（必须由部署者填写） =====
# 远程厂商填 api_key；本地 OpenAI 兼容服务填 local
AI_MODE=
# 本地服务未开启鉴权时留空；开启鉴权时填写本地服务的 Key
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# ===== 认证 =====
JWT_SECRET=please-change-me-to-a-strong-random-secret
JWT_EXPIRE_HOURS=168

# ===== 跨域（逗号分隔） =====
CORS_ORIGINS=http://localhost:3000

# ===== 会员管理 =====
# 业务时区，同时应用到 PostgreSQL 会话和会员日期判断
BUSINESS_TIMEZONE=Asia/Shanghai
# 系统管理员邮箱。该邮箱不能通过公开注册占用，账号需预先存在
SYSTEM_ADMIN_EMAIL=ronalffon@666.com
# 可管理会员的既有用户 ID，逗号分隔；留空禁用管理员操作
# 兼容旧配置，建议完成邮箱管理员迁移后清空
ADMIN_USER_IDS=
